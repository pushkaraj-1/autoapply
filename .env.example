# Copy this file to .env and fill in your own values. Never share or commit .env.

# Required: the AI that writes answers and cover letters (https://openrouter.ai/keys).
OPENROUTER_KEY=
# Optional: models to use. Short answers use OPENROUTER_MODEL; essays and cover
# letters use OPENROUTER_WRITING_MODEL; job scoring uses OPENROUTER_SCORING_MODEL.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_WRITING_MODEL=
OPENROUTER_SCORING_MODEL=

# Optional: your Workday sign-in, so the extension can sign in to Workday sites for you.
# Only Workday pages, and only the extension, can ever ask the local server for these.
WORKDAY_EMAIL=
WORKDAY_PASSWORD=

# Optional job scanner sources. Leave blank to skip them.
ADZUNA_APP_ID=
ADZUNA_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
# Finds companies' careers sites for jobs listed on LinkedIn, Indeed and the like.
# Free key: https://brave.com/search/api/ (Google's Custom Search API is closed to new projects)
BRAVE_SEARCH_KEY=
THEMUSE_API_KEY=

# Optional: a Gmail app password for your application inbox
# (https://myaccount.google.com/apppasswords). The auto apply queue then reads the
# security code Greenhouse emails after Submit by itself; only those emails are read.
OTP_EMAIL_ADDRESS=
OTP_EMAIL_APP_PASSWORD=
