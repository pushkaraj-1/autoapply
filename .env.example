# Copy this file to .env and fill in your own values. Never share or commit .env.

# Required: the AI that writes answers and cover letters (https://openrouter.ai/keys).
OPENROUTER_KEY=
# Optional: models to use. Short answers use OPENROUTER_MODEL; essays and cover
# letters use OPENROUTER_WRITING_MODEL; job scoring uses OPENROUTER_SCORING_MODEL.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_WRITING_MODEL=
OPENROUTER_SCORING_MODEL=

# Optional: your Workday sign-in, so the extension can sign in to Workday sites for you.
# Only Workday pages, and only the extension, can ever ask the local server for these.
WORKDAY_EMAIL=
WORKDAY_PASSWORD=

# Optional job scanner sources. Leave blank to skip them.
ADZUNA_APP_ID=
ADZUNA_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
THEMUSE_API_KEY=
